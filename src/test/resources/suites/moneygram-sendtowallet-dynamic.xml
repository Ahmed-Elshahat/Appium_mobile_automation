<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="MoneyGram Send to Wallet Dynamic Beneficiary" verbose="1">
    <!--
        Registers a fresh full-tier NAT user via backend API, triggers MoneyGram MQ refresh,
        queries an enabled Send to Wallet corridor from EPAY_MTO_CORE.MTO_CNTRY_CRNCY_DLV,
        adds + activates a beneficiary using that corridor, then transfers to it.

        Requires:
          - SIT backend access (registration API + IVR callback)
          - Oracle DB access (MTO corridor table + EAI_MESSAGE_DUMP for IVR x-request-id)
          - IBM MQ access (RefreshMGCodeTableRq)

        Run:
          mvn clean test "-Dsuite=suites/moneygram-sendtowallet-dynamic.xml" "-Dprofile=sit-remittance"
              -Denv=SIT -Dremote=true
    -->
    <test name="MoneyGram Send to Wallet (Dynamic)">
        <classes>
            <class name="com.urpay.tests.remittance.MoneyGramSendToWalletDynamicTest"/>
        </classes>
    </test>
</suite>
