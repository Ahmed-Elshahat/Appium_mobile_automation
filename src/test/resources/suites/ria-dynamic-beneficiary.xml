<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="RIA Dynamic Beneficiary" verbose="1">
    <!--
        RIA beneficiary creation + transfer using REAL corridor data from MTO DB.

        Flow:
          1. Triggers MQ to refresh RIA code table (RIARefreshCodeTableRq)
          2. Queries DB for enabled Cash Pickup + Bank Deposit corridors
          3. Registers a fresh user + tops up balance
          4. Adds beneficiaries using the queried corridor data
          5. Activates beneficiaries in DB (IVR skip)
          6. Transfers to the newly created beneficiaries (real money)

        Requires: DB machine (MQ + Oracle + LambdaTest)

        Run:
          mvn clean test "-Dsuite=suites/ria-dynamic-beneficiary.xml" "-Dprofile=sit-remittance"
              -Denv=SIT -Dremote=true
    -->
    <test name="RIA Dynamic Beneficiary">
        <classes>
            <class name="com.urpay.tests.remittance.RIADynamicBeneficiaryTest"/>
        </classes>
    </test>
</suite>
