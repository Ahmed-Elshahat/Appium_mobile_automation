<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="MoneyGram Dynamic Beneficiary" verbose="1">
    <!--
        MoneyGram beneficiary creation using REAL corridor data from MTO DB.
        
        Flow:
          1. Triggers MQ to refresh MoneyGram code table
          2. Queries DB for enabled Cash Pickup + Bank Deposit corridors
          3. Registers a fresh user + tops up balance
          4. Adds beneficiaries using the queried corridor data
          5. Activates beneficiaries in DB (IVR skip)

        Requires: DB machine (MQ + Oracle + LambdaTest)

        Run:
          mvn clean test "-Dsuite=suites/moneygram-dynamic-beneficiary.xml" "-Dprofile=sit-remittance"
              -Denv=SIT -Dremote=true
    -->
    <test name="MoneyGram Dynamic Beneficiary">
        <classes>
            <class name="com.urpay.tests.remittance.MoneyGramDynamicBeneficiaryTest"/>
        </classes>
    </test>
</suite>
