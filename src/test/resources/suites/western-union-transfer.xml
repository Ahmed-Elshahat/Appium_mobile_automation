<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Western Union International Transfer Collection" verbose="1">
    <!--
        Remittance squad — Western Union International Transfer (MTO), Cash Pickup.

        Reuses the operator-agnostic InternationalTransferFlow (built for MoneyGram).

        One LambdaTest session, ONE pass through the flow:
          - testWesternUnionCashPickupTransfer logs in, drives to the CONFIRMATION page, validates
            it there (no money yet), THEN confirms end-to-end. The beneficiary→confirm steps run
            ONCE (the old separate no-money case was folded in). ⚠ REAL MONEY (small amount from
            sit-remittance).

        Run:
          mvn -f d:\mobile-automation\urpay-mobile-tests\pom.xml clean test ^
              "-Dsuite=suites/western-union-transfer.xml" "-Dprofile=sit-remittance"
    -->

    <test name="Western Union Cash Pickup">
        <groups>
            <run><include name="western-union"/></run>
        </groups>
        <classes>
            <class name="com.urpay.tests.remittance.WesternUnionTransferTest"/>
        </classes>
    </test>

</suite>
