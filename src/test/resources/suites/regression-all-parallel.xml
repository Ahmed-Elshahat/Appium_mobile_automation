<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  ══════════════════════════════════════════════════════════════════════════════
  FULL REGRESSION — ALL DOMAINS in ONE parallel suite, ONE command, 19 devices.
  ══════════════════════════════════════════════════════════════════════════════

  ONE JVM loads all four data profiles at once (ConfigManager accepts a
  comma-separated -Dprofile). ONE 19-thread pool balances across every test, so
  device utilisation is better than four fixed pools.

  Run (single command):
    mvn clean test "-Dsuite=suites/regression-all-parallel.xml" ^
        "-Dprofile=sit-wmv,sit-cards,sit-remittance,sit-dmp-all" -Dremote=true

  parallel="tests" thread-count="19": up to 19 <test> blocks (= 19 LambdaTest
  sessions) run at once; the rest queue. EVERY <test> is a SINGLE class = fully
  parallel, NO serial blocks. Each actively-run <test> uses its OWN account.

  NOTES:
   • Profiles load left→right; sit-remittance last so its urpayUser.* (the only
     cross-profile clash) wins over sit-wmv's empty placeholder.
   • family-wallet = 7 PARALLEL <test> blocks, each on its own account
     (collisions de-collided 2026-07-12); no shared parent/kid, no serial block.
   • Card method-subsets (change-pin / card-replacement / cancel-card-steps /
     validate-card-removed / physical-card) are covered by the whole-class
     mada-cards / signature-cards and are NOT repeated.
   • Remittance excludes MoneyGram Cash Pickup & Transfast Send-to-Wallet (no accounts).
   • DMP = 29 tests (browse / orders / gift / mokafaa / promo) on the sit-dmp-all
     profile; order/pay/promo tests need funded wallets or they fail at payment.
-->
<suite name="URPay Full Regression (All Domains, Parallel)" verbose="1"
       parallel="tests" thread-count="19" group-by-instances="true">

    <listeners>
        <listener class-name="com.urpay.core.RetryListener"/>
    </listeners>

    <!--
      SCHEDULING: Longest-Processing-Time-first (LPT), ordered by REAL measured
      runtimes pulled from the LambdaTest Automation API (session durations,
      probed 2026-07-12; regenerate with tools/lt-durations.ps1). With a fixed
      19-device cap, TestNG picks up <test> blocks in document order as threads
      free up, so starting the longest first lets short tests backfill freed
      device slots and shrinks the idle-device tail. The ~Ns note on each block
      is its measured session duration. Profile precedence still comes from the
      -Dprofile flag order, NOT the order of tests here.
    -->

    <!-- Family Wallet — FULLY PARALLEL (one class per <test>). No serial blocks.
         All known shared-account collisions resolved 2026-07-12 (detector:
         tools/shared-accounts.ps1).
           • Local Transfer uses urpayUser (0520281395); no other in-suite test
             shares it (Notifications has its OWN account 0548785333). The
             Add-*-Beneficiary tests are NOT in this suite — they live in their own
             DB/IVR-connected suites (add-local/international/moneygram-beneficiary.xml).
           • Receive Gift needs a pre-seeded UNOPENED gift on sendGift.kid, since
             Send Gift no longer runs before it. -->
    <test name="Family - Send Gift (parent)"> <!-- ~540s -->
        <classes><class name="com.urpay.tests.wallet.SendGiftFromParentTest"/></classes>
    </test>
    <test name="Family - Receive Gift (kid)"> <!-- ~553s (needs pre-seeded unopened gift) -->
        <classes><class name="com.urpay.tests.wallet.KidReceiveGiftTest"/></classes>
    </test>
    <test name="Family - Request Money"> <!-- ~449s -->
        <classes><class name="com.urpay.tests.wallet.FamilyRequestMoneyTest"/></classes>
    </test>
    <test name="Family - Direct Topup Positive"> <!-- ~163s -->
