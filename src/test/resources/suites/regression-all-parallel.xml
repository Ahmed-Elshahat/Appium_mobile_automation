    </test>
    <test name="Family - Delink"> <!-- ~176s -->
        <classes><class name="com.urpay.tests.wallet.DelinkFromParentTest"/></classes>
    </test>
    <test name="Family - Permission Control"> <!-- ~162s -->
        <classes><class name="com.urpay.tests.wallet.PermissionControlTest"/></classes>
    </test>

