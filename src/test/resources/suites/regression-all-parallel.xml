<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  ══════════════════════════════════════════════════════════════════════════════
  FULL REGRESSION — ALL DOMAINS in ONE parallel suite, ONE command, 20 devices.
  ══════════════════════════════════════════════════════════════════════════════

  ONE JVM loads all three data profiles at once (ConfigManager accepts a
  comma-separated -Dprofile). ONE 20-thread pool balances across every test, so
  device utilisation is better than three fixed pools.

  Run (single command):
    mvn clean test "-Dsuite=suites/regression-all-parallel.xml" ^
        "-Dprofile=sit-wmv,sit-cards,sit-remittance" -Dremote=true

  parallel="tests" thread-count="20": up to 20 <test> blocks (= 20 LambdaTest
  sessions = 20 devices) run at once; the rest queue. Each <test> = 1 unique account.

  NOTES:
   • Profiles load left→right; sit-remittance last so its urpayUser.* (the only
     cross-profile clash) wins over sit-wmv's empty placeholder.
   • family-wallet = ONE serial <test> block (shared parent/kid accounts).
   • Card method-subsets (change-pin / card-replacement / cancel-card-steps /
     validate-card-removed / physical-card) are covered by the whole-class
     mada-cards / signature-cards and are NOT repeated.
   • Remittance excludes MoneyGram Cash Pickup & Transfast Send-to-Wallet (no accounts).
-->
<suite name="URPay Full Regression (All Domains, Parallel)" verbose="1"
       parallel="tests" thread-count="20" group-by-instances="true">

    <listeners>
        <listener class-name="com.urpay.core.RetryListener"/>
    </listeners>

