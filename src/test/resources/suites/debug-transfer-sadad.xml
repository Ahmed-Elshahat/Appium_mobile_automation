<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Debug - Local Transfer + SADAD" verbose="1"
       parallel="tests" thread-count="2" group-by-instances="true">
    <listeners>
        <listener class-name="com.urpay.core.RetryListener"/>
    </listeners>
    <test name="Local Transfer">
        <classes><class name="com.urpay.tests.remittance.LocalTransferTest"/></classes>
    </test>
    <test name="SADAD Payment">
        <groups><run><include name="sadad-payment"/></run></groups>
        <classes><class name="com.urpay.tests.payments.SadadBillPaymentTest"/></classes>
    </test>
</suite>
