<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="RIA Bank Deposit Dynamic Beneficiary" verbose="1">
    <!--
        Registers a fresh full-tier NAT user via backend API, triggers RIA MQ refresh,
        queries an enabled Bank Deposit corridor from EPAY_MTO_CORE.MTO_CNTRY_CRNCY_DLV,
        adds + activates a beneficiary using that corridor, then transfers to it.

        Requires:
          - SIT backend access (registration API + IVR callback)
          - Oracle DB access (MTO corridor table + EAI_MESSAGE_DUMP for IVR x-request-id)
          - IBM MQ access (RIARefreshCodeTableRq)

        Run:
          mvn clean test "-Dsuite=suites/ria-bankdeposit-dynamic.xml" "-Dprofile=sit-remittance"
              -Denv=SIT -Dremote=true
    -->
    <test name="RIA Bank Deposit (Dynamic)">
        <classes>
            <class name="com.urpay.tests.remittance.RIABankDepositDynamicTest"/>
        </classes>
    </test>
</suite>
