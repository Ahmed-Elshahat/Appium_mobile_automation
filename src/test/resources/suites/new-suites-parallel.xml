<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Newly-migrated NON-family WMV suites, run in PARALLEL on LambdaTest as a SINGLE mvn process.
  parallel="tests" thread-count="5" → TestNG runs each <test> in its own thread, and
  DriverFactory hands each thread its own ThreadLocal<AppiumDriver> = a separate LambdaTest
  session per suite. One mvn process = one target/ dir (no file-lock contention).
  Accounts are pairwise-distinct, so concurrent execution is safe:
    reject-money-request                     0506913889 / 0520154446
    wallet-balance                           0529193979
    invite-friends                           0577977177
    forgot-passcode-default-tier-negative    0520110197
    forgot-passcode-default-tier-negative-02 0591181431
  Family suites are intentionally EXCLUDED (shared accounts) — see family-wallet.xml (sequential).
  Run: mvn test -Dsuite=suites/new-suites-parallel.xml -Dprofile=sit-wmv
-->
<suite name="New Suites (Parallel)" verbose="1" parallel="tests" thread-count="5" data-provider-thread-count="5">
    <test name="reject-money-request">
        <classes><class name="com.urpay.tests.wallet.RejectMoneyRequestTest"/></classes>
    </test>
    <test name="wallet-balance">
        <classes><class name="com.urpay.tests.wallet.WalletBalanceTest"/></classes>
    </test>
    <test name="invite-friends">
        <classes><class name="com.urpay.tests.wallet.InviteFriendsShareTest"/></classes>
    </test>
    <test name="forgot-passcode-default-tier-negative">
        <classes><class name="com.urpay.tests.auth.ForgotPasscodeDefaultTierNegativeTest"/></classes>
    </test>
    <test name="forgot-passcode-default-tier-negative-02">
        <classes><class name="com.urpay.tests.auth.ForgotPasscodeDefaultTierLoginNegativeTest"/></classes>
    </test>
</suite>
