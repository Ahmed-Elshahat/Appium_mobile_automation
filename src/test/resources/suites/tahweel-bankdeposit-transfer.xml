<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Tahweel AlRajhi (H2H) Account Deposit Transfer Collection" verbose="1">
    <!--
        Remittance squad — Tahweel AlRajhi (H2H) International Transfer (MTO), Account Deposit
        (a.k.a. Bank Deposit). Reuses the operator-agnostic InternationalTransferFlow.

        Uses its OWN account (0520926735, poi 1308451788 NAT) with an active Account-Deposit
        beneficiary — separate from the Cash Pickup account — so this is a standalone class/suite.

        One LambdaTest session, ONE pass through the flow:
          - testTahweelBankDepositTransfer logs in, drives to the CONFIRMATION page, validates it
            there (no money yet), THEN confirms end-to-end. ⚠ REAL MONEY (small amount).

        Run:
          mvn -f d:\mobile-automation\urpay-mobile-tests\pom.xml clean test ^
              "-Dsuite=suites/tahweel-bankdeposit-transfer.xml" "-Dprofile=sit-remittance"
    -->

    <test name="Tahweel AlRajhi Account Deposit">
        <groups>
            <run><include name="tahweel-bankdeposit"/></run>
        </groups>
        <classes>
            <class name="com.urpay.tests.remittance.TahweelBankDepositTest"/>
        </classes>
    </test>

</suite>
