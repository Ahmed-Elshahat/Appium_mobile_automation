<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  eSIM + Sadad verification — quick pre-flight before the full P&C run.
  2 parallel sessions, unique accounts: Travel eSIM (0520778001), Sadad (0520504744).
  Sadad Bills + Payment share the sadad.* account, so they run sequentially in one block.
-->
<suite name="eSIM + Sadad Verification" verbose="1"
       parallel="tests" thread-count="2" group-by-instances="true">

    <test name="Travel E-SIM">
        <groups><run><include name="travel-esim"/></run></groups>
        <classes><class name="com.urpay.tests.payments.TravelEsimTest"/></classes>
    </test>

    <test name="Sadad Bills and Payment">
        <groups><run>
            <include name="sadad-bills"/>
            <include name="sadad-payment"/>
        </run></groups>
        <classes>
            <class name="com.urpay.tests.payments.SadadBillsTest"/>
            <class name="com.urpay.tests.payments.SadadBillPaymentTest"/>
        </classes>
    </test>

</suite>
