<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Platinum Card with Fresh Registration" verbose="1">
    <!--
        Registers a fresh full-tier NAT user via backend API,
        then runs all card management tests with card issuance + IVR skip.

        Requires:
          - SIT backend access (registration API + IVR callback)
          - Oracle DB access (EAI_MESSAGE_DUMP for IVR x-request-id)
          - Backend simulator (tahaqoq seeding)

        Run:
          mvn clean test "-Dsuite=suites/platinum-cards-registration.xml" "-Dprofile=sit-cards"
              -Denv=SIT -Dremote=true
    -->
    <test name="Platinum Card (Fresh User)">
        <classes>
            <class name="com.urpay.tests.payments.PlatinumCardRegistrationTest"/>
        </classes>
    </test>
</suite>
