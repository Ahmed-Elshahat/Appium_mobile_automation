<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Kid Receive Gift suite — ONE LambdaTest session, two phases (parent send → logout → kid open).

  A single test class (KidReceiveGiftTest) runs both chained phases, so the whole journey shares
  one session/device (BaseTest quits the driver once at @AfterClass):
    1. testParentSendsGiftToKid — parent sends a Marriage gift to the kid, then logs out.
    2. testKidOpensReceivedGift — kid logs in and opens the latest received gift.

  Run: mvn test "-Dsuite=suites/kid-receive-gift.xml" "-Dprofile=sit-wmv"
-->
<suite name="Kid Receive Gift" verbose="1" parallel="none">
    <test name="parent-send-then-kid-receive" preserve-order="true">
        <classes><class name="com.urpay.tests.wallet.KidReceiveGiftTest"/></classes>
    </test>
</suite>
