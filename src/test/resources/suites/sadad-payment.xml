<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Saddad Bill Payment Suite" verbose="1">
    <listeners>
        <listener class-name="com.urpay.core.TestExecutionListener"/>
    </listeners>

    <!-- Saddad Bill Payment (different types) + Transaction Verification -->
    <test name="Saddad Bill Payments">
        <groups>
            <run>
                <include name="sadad-payment"/>
            </run>
        </groups>
        <classes>
            <class name="com.urpay.tests.payments.SadadBillPaymentTest"/>
        </classes>
    </test>
</suite>
