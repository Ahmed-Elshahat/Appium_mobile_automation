<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  ══════════════════════════════════════════════════════════════════════════════
  WMV PARALLEL REGRESSION — up to 12 concurrent devices.  Profile: sit-wmv
  ══════════════════════════════════════════════════════════════════════════════

  FLAT parallel suite (same pattern as remittance-collection / all-wallet-settings).
  parallel="tests" + thread-count="12": TestNG runs up to 12 <test> blocks at once,
  queuing the rest.  Each <test> = 1 thread = 1 LambdaTest session = 1 device =

  DEVICE BUDGET: 12 here + 4 (cards) + 4 (remittance) = 20 = LambdaTest cap, so all
  three can run AT THE SAME TIME. Running this suite ALONE? Bump thread-count to 20.
  1 UNIQUE account (two live sessions on one account → the later login kicks the
  first).  Every feature below uses its own dedicated account in sit-wmv.properties.

  Run:
    mvn clean test "-Dsuite=suites/regression-wmv-parallel.xml" "-Dprofile=sit-wmv" -Dremote=true

  NOTE: family-wallet tests share/overlap scarce parent-kid accounts, so they are
  grouped into ONE <test> block → they run SERIALLY on a single device (never
  concurrently with each other).  delink-from-parent is covered here (not repeated
  as a standalone test) to avoid a duplicate DelinkFromParentTest on the same account.
-->
<suite name="URPay WMV Parallel Regression" verbose="1"
       parallel="tests" thread-count="12" group-by-instances="true">

    <listeners>
        <listener class-name="com.urpay.core.RetryListener"/>
    </listeners>

    <!-- ── Auth: Change Passcode ─────────────────────────────── -->
    <test name="Change Passcode Default Tier">
        <classes><class name="com.urpay.tests.settings.ChangePasscodeDefaultTierTest"/></classes>
    </test>
    <test name="Change Passcode Default Tier Negative">
        <classes><class name="com.urpay.tests.settings.ChangePasscodeDefaultTierNegativeTest"/></classes>
    </test>
    <test name="Change Passcode Family Tier">
        <classes><class name="com.urpay.tests.settings.ChangePasscodeFamilyTierTest"/></classes>
    </test>
    <test name="Change Passcode Family Tier Negative">
        <classes><class name="com.urpay.tests.settings.ChangePasscodeFamilyTierNegativeTest"/></classes>
    </test>
    <test name="Change Passcode Full Tier">
        <classes><class name="com.urpay.tests.settings.ChangePasscodeFullTierTest"/></classes>
    </test>
    <test name="Change Passcode Full Tier Negative">
        <classes><class name="com.urpay.tests.settings.ChangePasscodeFullTierNegativeTest"/></classes>
    </test>
    <test name="Change Passcode Visitor Tier">
        <classes><class name="com.urpay.tests.settings.ChangePasscodeVisitorTierTest"/></classes>
    </test>
    <test name="Change Passcode Visitor Tier Negative">
        <classes><class name="com.urpay.tests.settings.ChangePasscodeVisitorTierNegativeTest"/></classes>
    </test>

    <!-- ── Auth: Forgot Passcode ─────────────────────────────── -->
    <test name="Forgot Passcode Default Tier">
        <classes><class name="com.urpay.tests.auth.ForgotPasscodeDefaultTierTest"/></classes>
    </test>
    <test name="Forgot Passcode Default Tier Negative">
        <classes><class name="com.urpay.tests.auth.ForgotPasscodeDefaultTierNegativeTest"/></classes>
    </test>
    <test name="Forgot Passcode Default Tier Login Negative">
        <classes><class name="com.urpay.tests.auth.ForgotPasscodeDefaultTierLoginNegativeTest"/></classes>
    </test>
    <test name="Forgot Passcode Family Tier">
        <classes><class name="com.urpay.tests.auth.ForgotPasscodeFamilyTierTest"/></classes>
    </test>
    <test name="Forgot Passcode Family Tier Negative">
        <classes><class name="com.urpay.tests.auth.ForgotPasscodeFamilyTierNegativeTest"/></classes>
    </test>
    <test name="Forgot Passcode Family Tier Login Negative">
        <classes><class name="com.urpay.tests.auth.ForgotPasscodeFamilyTierLoginNegativeTest"/></classes>
    </test>
    <test name="Forgot Passcode Full Tier">
        <classes><class name="com.urpay.tests.auth.ForgotPasscodeFullTierTest"/></classes>
    </test>
    <test name="Forgot Passcode Full Tier Negative">
        <classes><class name="com.urpay.tests.auth.ForgotPasscodeFullTierNegativeTest"/></classes>
    </test>
    <test name="Forgot Passcode Full Tier Login Negative">
        <classes><class name="com.urpay.tests.auth.ForgotPasscodeFullTierLoginNegativeTest"/></classes>
    </test>
    <test name="Forgot Passcode Visitor Tier">
        <classes><class name="com.urpay.tests.auth.ForgotPasscodeVisitorTierTest"/></classes>
    </test>
    <test name="Forgot Passcode Visitor Tier Negative">
        <classes><class name="com.urpay.tests.auth.ForgotPasscodeVisitorTierNegativeTest"/></classes>
    </test>
    <test name="Forgot Passcode Visitor Tier Login Negative">
        <classes><class name="com.urpay.tests.auth.ForgotPasscodeVisitorTierLoginNegativeTest"/></classes>
    </test>

    <!-- ── Auth: Registration / Phone ────────────────────────── -->
    <test name="Registration Using Invitation Code">
        <classes><class name="com.urpay.tests.wallet.RegistrationUsingInvitationCodeTest"/></classes>
    </test>
    <test name="Change Phone Number Full Tier">
        <classes><class name="com.urpay.tests.settings.ChangePhoneNumberForFullTierTest"/></classes>
    </test>

    <!-- ── Settings & Account ────────────────────────────────── -->
    <test name="Account Details">
        <classes><class name="com.urpay.tests.wallet.AccountDetailsTest"/></classes>
    </test>
    <test name="Account Statement">
        <classes><class name="com.urpay.tests.wallet.AccountStatementTest"/></classes>
    </test>
    <test name="Change App Language">
        <classes><class name="com.urpay.tests.settings.ChangeAppLanguageTest"/></classes>
    </test>
    <test name="Rating">
        <classes><class name="com.urpay.tests.settings.RatingTest"/></classes>
    </test>
    <test name="Privacy And Terms">
        <classes><class name="com.urpay.tests.settings.PrivacyAndTermsTest"/></classes>
    </test>
    <test name="Notifications">
        <classes><class name="com.urpay.tests.wallet.NotificationsTest"/></classes>
    </test>

    <!-- ── Wallet & Money ────────────────────────────────────── -->
    <test name="Wallet Balance">
        <classes><class name="com.urpay.tests.wallet.WalletBalanceTest"/></classes>
    </test>
    <test name="Send Money Request And Approve">
        <classes><class name="com.urpay.tests.wallet.SendMoneyRequestApproveTest"/></classes>
    </test>
    <test name="Reject Money Request">
        <classes><class name="com.urpay.tests.wallet.RejectMoneyRequestTest"/></classes>
    </test>
    <test name="Invite Friends">
        <classes><class name="com.urpay.tests.wallet.InviteFriendsShareTest"/></classes>
    </test>
    <test name="Auto Top-up">
        <groups><run><include name="auto-topup"/></run></groups>
        <classes><class name="com.urpay.tests.wallet.AutoTopupCreationTest"/></classes>
    </test>
    <test name="Family Mission">
        <classes><class name="com.urpay.tests.wallet.FamilyMissionTest"/></classes>
    </test>

    <!-- ── Qatta ─────────────────────────────────────────────── -->
    <test name="Edit Group Qatta Details">
        <classes><class name="com.urpay.tests.wallet.EditGroupQattaDetailsTest"/></classes>
    </test>
    <test name="Pay Group Qatta">
        <classes><class name="com.urpay.tests.wallet.PayGroupQattaTest"/></classes>
    </test>
    <test name="Pay Quick Qatta">
        <classes><class name="com.urpay.tests.wallet.PayQuickQattaTest"/></classes>
    </test>
    <test name="Reject Group Qatta">
        <classes><class name="com.urpay.tests.wallet.RejectGroupQattaTest"/></classes>
    </test>
    <test name="Reject Quick Qatta">
        <classes><class name="com.urpay.tests.wallet.RejectQuickQattaTest"/></classes>
    </test>

    <!-- ── Family Wallet (SERIAL on ONE device — shared parent/kid accounts) ── -->
    <test name="Family Wallet (serial)">
        <classes>
            <class name="com.urpay.tests.wallet.SendGiftFromParentTest"/>
            <class name="com.urpay.tests.wallet.KidReceiveGiftTest"/>
            <class name="com.urpay.tests.wallet.FamilyRequestMoneyTest"/>
            <class name="com.urpay.tests.wallet.DirectTopupPositiveTest"/>
            <class name="com.urpay.tests.wallet.DirectTopupNegativeTest"/>
            <class name="com.urpay.tests.wallet.PermissionControlTest"/>
            <class name="com.urpay.tests.wallet.DelinkFromParentTest"/>
        </classes>
    </test>

</suite>
