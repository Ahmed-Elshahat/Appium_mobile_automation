<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Mada Bracelet Card Management" verbose="1">
    <!--
        Registers a fresh full-tier NAT user via backend API, then runs all card management
        tests. Bracelet issuance (Request Card) fills the national-address form used by
        Request Physical Card, not the digital PIN+OTP+IVR flow.

        Requires:
          - SIT backend access (registration API + IVR callback)
          - Oracle DB access (EAI_MESSAGE_DUMP for IVR x-request-id)
          - Backend simulator (tahaqoq seeding)

        Run:
          mvn clean test "-Dsuite=suites/bracelet-cards.xml" "-Dprofile=sit-cards"
              -Denv=SIT -Dremote=true
    -->
    <test name="Mada Bracelet (Fresh User)">
        <classes>
            <class name="com.urpay.tests.payments.BraceletCardTest"/>
        </classes>
    </test>
</suite>
